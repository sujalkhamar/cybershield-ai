# ==============================
# CyberShield-AI .gitignore
# ==============================

# 1. Datasets & Large Files (GitHub 100MB Limit)
*.csv
*.tsv
*.pcap
*.zip
*.tar.gz
datasets/
CICIDS.csv

# 2. Database & Logs
*.db
*.sqlite
*.sqlite3
backend/cybershield.db
cybershield.db
*.log
logs/

# 3. Machine Learning Models & Weights
# (Note: .pth files are allowed so the project works out-of-the-box when pulled)
*.onnx
*.h5
*.pkl

# 4. Security & Environment Variables
.env
.env.local
.env.development
.env.test
.env.production
secrets.json
*.pem
*.key

# 5. Node.js & React Frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Python Environments & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env.bak/
venv.bak/

# 7. IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
